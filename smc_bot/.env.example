# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" (déjà exclu via .gitignore).

DJANGO_SECRET_KEY=change-me-with-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Deriv API ---
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEFAULT_FROM_EMAIL=noreply@smcbot.local
